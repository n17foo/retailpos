{
  "name": "retail-pos",
  "version": "0.5.3",
  "license": "Apache-2.0",
  "main": "index.js",
  "private": true,
  "scripts": {
    "start": "expo start",
    "android": "expo start --android --non-interactive",
    "ios": "expo start --ios --clear",
    "web": "expo start --web",
    "desktop": "NODE_ENV=development concurrently \"expo start --web --port 19006\" \"wait-on http://localhost:19006 && electron electron/main.js\"",
    "desktop:dev": "NODE_ENV=development electron electron/main.js",
    "desktop:build": "expo export --platform web && electron-builder --publish=never",
    "desktop:build-win": "expo export --platform web && electron-builder --win --publish=never",
    "desktop:build-mac": "expo export --platform web && electron-builder --mac --publish=never",
    "desktop:build-linux": "expo export --platform web && electron-builder --linux --publish=never",
    "test": "jest --config tests/jest.config.js --no-coverage --no-cache",
    "test:unit": "jest --config tests/jest.config.js --no-coverage --no-cache",
    "test:watch": "jest --config tests/jest.config.js --watch --no-cache",
    "test:coverage": "jest --config tests/jest.config.js --coverage --no-cache",
    "release": "standard-version",
    "release:minor": "standard-version --release-as minor",
    "release:major": "standard-version --release-as major",
    "release:patch": "standard-version --release-as patch",
    "latest": "yarn upgrade --latest && npx expo install --fix",
    "doctor": "npx expo-doctor",
    "lint": "npx tsc --noEmit && eslint . --ext .js,.jsx,.ts,.tsx",
    "lint:fix": "npx tsc --noEmit && eslint . --ext .js,.jsx,.ts,.tsx --fix",
    "lint:errors": "eslint . --ext .js,.jsx,.ts,.tsx --quiet",
    "depnedency:check": "npx expo install --check",
    "format": "prettier --write \"**/*.{js,jsx,ts,tsx,json,md}\"",
    "prepare": "husky"
  },
  "dependencies": {
    "@adyen/react-native": "^2.13.0",
    "@expo/vector-icons": "^15.0.2",
    "@react-native-community/netinfo": "12.0.1",
    "@react-navigation/bottom-tabs": "7.21.0",
    "@react-navigation/native": "7.5.1",
    "@react-navigation/native-stack": "7.21.0",
    "@react-navigation/stack": "7.12.1",
    "@shopify/flash-list": "2.3.2",
    "@stripe/stripe-terminal-react-native": "0.0.1-beta.33",
    "card-react-native": "1.0.9",
    "eventemitter3": "5.0.4",
    "expo": "~58.0.14",
    "expo-build-properties": "^58.0.11",
    "expo-camera": "~58.0.10",
    "expo-file-system": "~58.0.9",
    "expo-font": "~58.0.8",
    "expo-image": "~58.0.15",
    "expo-localization": "~58.0.4",
    "expo-sharing": "~58.0.19",
    "expo-splash-screen": "~58.0.10",
    "expo-sqlite": "~58.0.13",
    "expo-status-bar": "~58.0.3",
    "i18next": "26.5.2",
    "lodash.debounce": "^4.0.8",
    "nanoid": "6.0.2",
    "plist": "5.0.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-i18next": "17.1.0",
    "react-native": "0.88.0",
    "react-native-ble-plx": "3.5.1",
    "react-native-esc-pos-printer": "4.5.0",
    "react-native-gesture-handler": "~3.3.0",
    "react-native-get-random-values": "~2.0.0",
    "react-native-keychain": "10.0.0",
    "react-native-logs": "5.6.0",
    "react-native-nitro-image": "0.15.2",
    "react-native-nitro-modules": "^0.37.1",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-screens": "~4.30.0",
    "react-native-square-in-app-payments": "^2.1.2",
    "react-native-vision-camera": "5.2.3",
    "react-native-web": "^0.21.4",
    "react-native-worklets": "0.13.0",
    "react-native-worklets-core": "^1.6.3",
    "uuid": "^14.0.3",
    "winston": "3.19.0",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "@eslint/js": "10.0.1",
    "@testing-library/react-native": "14.1.0",
    "@types/jest": "30.0.0",
    "@types/lodash.debounce": "^4.0.9",
    "@types/react": "~19.3.0",
    "@types/react-native-square-in-app-payments": "1.4.4",
    "@typescript-eslint/eslint-plugin": "8.71.2",
    "@typescript-eslint/parser": "8.71.2",
    "concurrently": "^10.0.6",
    "electron": "^44.9.0",
    "electron-builder": "^26.15.3",
    "eslint": "10.13.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-prettier": "5.5.7",
    "eslint-plugin-react-hooks": "7.1.1",
    "husky": "^9.1.7",
    "jest": "~30.5.2",
    "lint-staged": "^17.6.0",
    "prettier": "3.9.10",
    "react-native-dotenv": "5.0.0",
    "standard-version": "^9.5.0",
    "test-renderer": "1.3.1",
    "ts-jest": "^29.4.15",
    "typescript": "~6.0.3",
    "wait-on": "^9.5.1"
  },
  "homepage": "./",
  "build": {
    "appId": "com.retail-pos.desktop",
    "productName": "RetailPOS",
    "directories": {
      "output": "dist-electron"
    },
    "extends": null,
    "files": [
      "electron/**/*",
      "dist/**/*",
      "package.json"
    ],
    "extraMetadata": {
      "main": "electron/main.js"
    },
    "electronFuses": {
      "runAsNode": false,
      "enableNodeOptionsEnvironmentVariable": false,
      "enableNodeCliInspectArguments": false,
      "enableCookieEncryption": true
    },
    "mac": {
      "category": "public.app-category.business",
      "target": [
        "dmg",
        "zip"
      ]
    },
    "win": {
      "target": "nsis"
    },
    "linux": {
      "target": "AppImage"
    },
    "extraResources": [
      {
        "from": "dist",
        "to": "dist",
        "filter": [
          "**/*"
        ]
      }
    ]
  },
  "expo": {
    "doctor": {
      "reactNativeDirectoryCheck": {
        "exclude": [
          "@stripe/stripe-terminal-react-native",
          "react-native-square-in-app-payments",
          "react-native-esc-pos-printer"
        ]
      }
    }
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "yarn lint:fix",
      "prettier --write"
    ],
    "*.{js,jsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md}": [
      "prettier --write"
    ]
  },
  "standard-version": {
    "types": [
      {
        "type": "feat",
        "section": "Features"
      },
      {
        "type": "fix",
        "section": "Bug Fixes"
      },
      {
        "type": "perf",
        "section": "Performance"
      },
      {
        "type": "refactor",
        "section": "Refactoring"
      },
      {
        "type": "test",
        "section": "Tests"
      },
      {
        "type": "chore",
        "hidden": true
      },
      {
        "type": "docs",
        "hidden": true
      },
      {
        "type": "style",
        "hidden": true
      }
    ],
    "skip": {
      "changelog": false
    }
  },
  "resolutions": {
    "**/@xmldom/xmldom": "0.9.12",
    "**/nanoid": "3.3.18",
    "**/plist": "3.1.1"
  }
}
